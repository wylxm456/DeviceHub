<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DeviceHub.Core\DeviceHub.Core.csproj" />
    <ProjectReference Include="..\DeviceHub.Drivers\DeviceHub.Drivers.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <None Include="libs\snap7.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- 双保险：无论 None 项如何被 SDK 通配处理，构建后强制把原生库复制到输出目录 -->
  <Target Name="CopySnap7Native" AfterTargets="Build">
    <Copy SourceFiles="libs\snap7.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
