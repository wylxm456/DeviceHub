<Window x:Class="DeviceHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DeviceHub.App.Views"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="DeviceHub — 多协议设备采集与监控平台"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen">
    <TabControl>
        <TabItem x:Name="AcquisitionTab" Header="设备采集">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,6">
                    <TextBlock Text="设备：" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="Name"
                              Width="230" VerticalContentAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="连接并开始采集"
                            Command="{Binding ConnectCommand}"
                            Padding="16,6" Margin="0,0,8,0" />
                    <Button Content="停止"
                            Command="{Binding DisconnectCommand}"
                            Padding="16,6" />
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               FontWeight="SemiBold" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding Points}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="10,0,10,10"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="点位" Binding="{Binding Name}" Width="160" />
                        <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="140" />
                        <DataGridTextColumn Header="数值" Binding="{Binding Value}" Width="120" />
                        <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="80" />
                        <DataGridTextColumn Header="更新时间" Binding="{Binding UpdateTime}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <TabItem x:Name="MotionTab" Header="运动控制">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="连接控制卡"
                            Command="{Binding ConnectCommand}"
                            Padding="16,6" Margin="0,0,8,0" />
                    <Button Content="断开"
                            Command="{Binding DisconnectCommand}"
                            Padding="16,6" Margin="0,0,20,0" />
                    <Button Content="急 停"
                            Command="{Binding EmergencyStopCommand}"
                            Padding="24,6"
                            Background="#D9534F" Foreground="White" FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               FontWeight="SemiBold" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding ErrorMessage}"
                           Foreground="#D9534F"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Axes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <GroupBox Header="{Binding Name}" Width="230" Margin="0,0,10,10" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Position, StringFormat=位置：{}{0:0.###} mm}"
                                                       FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding StateText}" Foreground="#337AB7" Margin="0,0,0,8" />
                                            <UniformGrid Columns="2">
                                                <Button Content="回零" Command="{Binding HomeCommand}"
                                                        Padding="0,6" Margin="0,0,4,4" />
                                                <Button Content="停止" Command="{Binding StopCommand}"
                                                        Padding="0,6" Margin="4,0,0,4" />
                                            </UniformGrid>
                                            <UniformGrid Columns="2">
                                                <Button Content="Jog ◀ 按住" Tag="-1"
                                                        PreviewMouseLeftButtonDown="JogButton_Down"
                                                        PreviewMouseLeftButtonUp="JogButton_Up"
                                                        Padding="0,6" Margin="0,0,4,8" />
                                                <Button Content="Jog ▶ 按住" Tag="1"
                                                        PreviewMouseLeftButtonDown="JogButton_Down"
                                                        PreviewMouseLeftButtonUp="JogButton_Up"
                                                        Padding="0,6" Margin="4,0,0,8" />
                                            </UniformGrid>
                                            <UniformGrid Columns="2" Margin="0,0,0,4">
                                                <StackPanel Margin="0,0,4,0">
                                                    <TextBlock Text="目标(mm)" FontSize="11" />
                                                    <TextBox Text="{Binding TargetInput, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Margin="4,0,0,0">
                                                    <TextBlock Text="速度(mm/s)" FontSize="11" />
                                                    <TextBox Text="{Binding SpeedInput, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </UniformGrid>
                                            <Button Content="定位运动" Command="{Binding MoveAbsoluteCommand}" Padding="0,6" />
                                            <TextBlock Text="{Binding ErrorText}"
                                                       Foreground="#D9534F" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </GroupBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <views:MotionCanvasView Grid.Column="1" Width="480" Margin="6,0,0,0"
                                            VerticalAlignment="Top" />
                </Grid>
            </DockPanel>
        </TabItem>
        <TabItem x:Name="VisionTab" Header="视觉定位">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="连接相机"
                            Command="{Binding ConnectCameraCommand}"
                            Padding="16,6" Margin="0,0,8,0" />
                    <Button Content="断开相机"
                            Command="{Binding DisconnectCameraCommand}"
                            Padding="16,6" Margin="0,0,8,0" />
                    <Button Content="单帧定位"
                            Command="{Binding LocateCommand}"
                            Padding="16,6" Margin="0,0,8,0" />
                    <Button Content="九点标定"
                            Command="{Binding CalibrateCommand}"
                            Padding="16,6" Margin="0,0,8,0" />
                    <Button Content="视觉引导运动"
                            Command="{Binding GuidedMoveCommand}"
                            Padding="16,6"
                            Background="#337AB7" Foreground="White" FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               FontWeight="SemiBold" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding ErrorMessage}"
                           Foreground="#D9534F"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" VerticalAlignment="Top">
                        <Image Source="{Binding CameraImage}" Width="640" Height="480" Stretch="Fill" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <GroupBox Header="定位结果" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding LocateResultText}" TextWrapping="Wrap" FontSize="14" />
                        </GroupBox>
                        <GroupBox Header="标定状态" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding CalibrationText}" TextWrapping="Wrap" FontSize="14" />
                        </GroupBox>
                        <GroupBox Header="操作日志" Padding="8">
                            <ListBox ItemsSource="{Binding LogLines}" Height="220"
                                     FontFamily="Consolas" FontSize="12" />
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </TabItem>

        <TabItem x:Name="CurveTab" Header="实时曲线">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="{Binding PauseButtonText}"
                            Command="{Binding TogglePauseCommand}"
                            Padding="16,6" Margin="0,0,8,0" />
                    <Button Content="清空"
                            Command="{Binding ClearCommand}"
                            Padding="16,6" />
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               FontWeight="SemiBold" />
                </StackPanel>

                <GroupBox Header="显示点位" DockPanel.Dock="Left"
                          Width="160" Padding="6" VerticalAlignment="Top">
                    <ItemsControl ItemsSource="{Binding PointOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                          Margin="0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <lvc:CartesianChart Series="{Binding Series}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    LegendPosition="Top" />
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
