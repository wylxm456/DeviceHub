<Window x:Class="DeviceHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeviceHub — 多协议设备采集与监控平台"
        Height="620" Width="960"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,6">
            <TextBlock Text="设备：" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice}"
                      DisplayMemberPath="Name"
                      Width="230" VerticalContentAlignment="Center" Margin="0,0,10,0" />
            <Button Content="连接并开始采集"
                    Command="{Binding ConnectCommand}"
                    Padding="16,6" Margin="0,0,8,0" />
            <Button Content="停止"
                    Command="{Binding DisconnectCommand}"
                    Padding="16,6" />
            <TextBlock Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       FontWeight="SemiBold" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Points}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="10,0,10,10"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="点位" Binding="{Binding Name}" Width="160" />
                <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="140" />
                <DataGridTextColumn Header="数值" Binding="{Binding Value}" Width="120" />
                <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="80" />
                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdateTime}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
