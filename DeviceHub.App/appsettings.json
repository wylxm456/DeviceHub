{
  "Vision": {
    "ImageWidth": 640,
    "ImageHeight": 480,
    "ScalePxPerMm": 10,
    "WorldOriginX": -32,
    "WorldOriginY": -24,
    "WorkpieceLengthMm": 4.0,
    "WorkpieceWidthMm": 3.0
  },
  "Motion": {
    "Name": "模拟运动控制卡",
    "DriverType": "SimMotion",
    "Axes": [
      { "Id": 0, "Name": "X轴", "SoftLimitPositive": 300, "SoftLimitNegative": -300, "DefaultSpeed": 50 },
      { "Id": 1, "Name": "Y轴", "SoftLimitPositive": 300, "SoftLimitNegative": -300, "DefaultSpeed": 50 },
      { "Id": 2, "Name": "Z轴", "SoftLimitPositive": 100, "SoftLimitNegative": 0, "DefaultSpeed": 25 }
    ]
  },
  "Reconnect": {
    "FailureThreshold": 3,
    "BaseDelayMs": 1000,
    "MaxDelayMs": 15000
  },
  "Curve": {
    "MaxPoints": 300
  },
  "Hub": {
    "Devices": [
      {
        "Name": "模拟设备（内置）",
        "DriverType": "Simulated",
        "PollIntervalMs": 500,
        "Points": [
          { "Name": "温度", "Address": "SIM.TEMP", "DataType": "Real" },
          { "Name": "压力", "Address": "SIM.PRESS", "DataType": "Real" },
          { "Name": "设定值", "Address": "SIM.SET_POINT", "DataType": "Real" }
        ]
      },
      {
        "Name": "S7 虚拟 PLC（snap7 模拟器）",
        "DriverType": "S7",
        "Ip": "127.0.0.1",
        "Rack": 0,
        "Slot": 2,
        "Cpu": "S7300",
        "PollIntervalMs": 500,
        "Points": [
          { "Name": "温度", "Address": "DB1.DBD0", "DataType": "Real" },
          { "Name": "压力", "Address": "DB1.DBD4", "DataType": "Real" },
          { "Name": "设定值", "Address": "DB1.DBD8", "DataType": "Real" },
          { "Name": "运行状态", "Address": "DB1.DBX12.0", "DataType": "Bool" }
        ]
      },
      {
        "Name": "Modbus TCP 从站（Modbus Slave 软件）",
        "DriverType": "ModbusTcp",
        "Ip": "127.0.0.1",
        "Port": 502,
        "SlaveId": 1,
        "PollIntervalMs": 500,
        "Points": [
          { "Name": "温度", "Address": "40001", "DataType": "Real" },
          { "Name": "压力", "Address": "40003", "DataType": "Real" },
          { "Name": "设定值", "Address": "40005", "DataType": "Real" },
          { "Name": "运行状态", "Address": "40007", "DataType": "Bool" }
        ]
      },
      {
        "Name": "Modbus RTU 从站（USB 串口 CH340，真机联调）",
        "DriverType": "ModbusRtu",
        "SerialPort": "COM5",
        "BaudRate": 9600,
        "Parity": "Even",
        "DataBits": 8,
        "StopBits": "One",
        "SlaveId": 1,
        "PollIntervalMs": 500,
        "Points": [
          { "Name": "温度", "Address": "40001", "DataType": "Real" },
          { "Name": "压力", "Address": "40003", "DataType": "Real" },
          { "Name": "设定值", "Address": "40005", "DataType": "Real" }
        ]
      }
    ]
  }
